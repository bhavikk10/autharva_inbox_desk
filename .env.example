MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GLM_MODEL=glm-4.7-flash
GLM_API_KEY=
# Direct structured extraction avoids exhausting the free API's budget on reasoning.
GLM_THINKING=disabled
GLM_MAX_OUTPUT_TOKENS=16384
GLM_RECOVER_REASONING_EXHAUSTION=true
MODEL_TIMEOUT_SECONDS=180
# Opt-in, visible local fallback after API/validation failures; no fabricated results.
ANALYSIS_FALLBACK_PROVIDER=
PRIMARY_ANALYSIS_BUDGET_SECONDS=90
FALLBACK_TIMEOUT_SECONDS=180
# Empty detects the system's IANA timezone; the UI allows an explicit override.
APP_TIMEZONE=
